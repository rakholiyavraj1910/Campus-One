# CampusOne Institutional Platform - Environment Configuration
# ============================================================
# Connect to your real Supabase cloud project by copying this file to `.env.local`:
#   cp .env.example .env.local
# Then fill in your project credentials from https://supabase.com -> Project Settings -> API.

# Supabase API URL (e.g. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client usage with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Backwards-compatible alias for older setups
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here

# Canonical Production Site URL (Used for Supabase Auth redirect URLs)
VITE_SITE_URL=https://campus-oneweb.vercel.app

# College Institution Details
VITE_APP_NAME=CampusOne
VITE_COLLEGE_NAME=Government Polytechnic Ahmedabad
VITE_COLLEGE_CODE=GPA-617

# Dedicated Administrator Canonical Email Mapping
VITE_ADMIN_EMAIL=vibhusuvaliya@gmail.com
